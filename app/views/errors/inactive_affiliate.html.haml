- error_page = { title: 'Search Temporarily Unavailable', paragraphs: [] }
- error_page[:paragraphs] << 'Your search did not work because the SearchGov site used by this search is currently <strong>inactive</strong>.'
- error_page[:paragraphs] << 'You may choose to contact the website where you did the search and let the website manager know about this issue. You can also use your browser’s back button to return to the website where you made your search and try a different action.'
- error_page[:paragraphs] << 'If you are the website manager and believe that the SearchGov site should instead be active, reach out to the SearchGov team to let them know. Find their contact information <a class="usa-link" href="https://digital.gov/guides/search#content-start" target="_blank" rel="noopener">within the SearchGov documentation</a>.'
= render_error_page(title: error_page[:title], paragraphs: error_page[:paragraphs])
